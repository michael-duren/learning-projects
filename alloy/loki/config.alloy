local.file_match "app" {
	path_targets = [{
		"__path__"     = "/logs/app.log",
		"service_name" = "demo-app",
	}]
}

loki.source.file "app" {
	targets    = local.file_match.app.targets
	forward_to = [loki.process.app.receiver]
}

loki.process "app" {
	// Extract every field the app writes.
	stage.json {
		expressions = {
			timestamp  = "",
			level      = "",
			path       = "",
			status     = "",
			message    = "",
			request_id = "",
		}
	}

	// Use the event time instead of the read time.
	stage.timestamp {
		source = "timestamp"
		format = "RFC3339Nano"
	}

	// Low-cardinality fields become stream labels.
	stage.labels {
		values = {
			level  = "",
			path   = "",
			status = "",
		}
	}

	// High-cardinality fields stay queryable without creating streams.
	stage.structured_metadata {
		values = {
			request_id = "",
		}
	}

	// Experiment stages go here.

	forward_to = [
		loki.write.local.receiver,
		loki.echo.processed.receiver,
	]
}

loki.echo "processed" { }

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
